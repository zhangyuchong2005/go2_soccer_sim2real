<mujoco model="go2 soccer shooting">
  <include file="go2_soccer_base.xml"/>

  <statistic center="0.8 0 0.2" extent="2.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.22 0.28 1"/>
    <global azimuth="-130" elevation="-18"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.34 0.48 0.62" rgb2="0.02 0.03 0.04" width="512" height="3072"/>
    <texture type="2d" name="pitch_tex" builtin="checker" mark="edge" rgb1="0.18 0.35 0.18" rgb2="0.12 0.24 0.12"
      markrgb="0.75 0.75 0.75" width="300" height="300"/>
    <material name="pitch" texture="pitch_tex" texuniform="true" texrepeat="7 7" reflectance="0.08"/>
    <material name="ball_yellow" rgba="0.95 0.72 0.08 1"/>
    <material name="goal_blue" rgba="0.15 0.45 0.95 0.35"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="pitch" friction="0.95 0.03 0.003"/>

    <body name="ball" pos="0.385 -0.152 0.105">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.105" mass="0.43" material="ball_yellow"
        friction="0.82 0.04 0.002" condim="6" priority="2"/>
    </body>

    <body name="target" pos="2.3 0 0.02">
      <geom name="goal_disc" type="cylinder" size="0.20 0.015" material="goal_blue" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
